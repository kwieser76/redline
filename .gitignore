# Environment – *.env files are ignored; the root .env is explicitly
# un-ignored so testing defaults are tracked in git.
*.env
!.env

# Python
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
*.egg-info/
dist/
build/
.eggs/

# Database
*.db
*.sqlite3

# Generated QR codes
static/qrcodes/*.png

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test / Coverage
.coverage
htmlcov/
.pytest_cache/
