# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# Flask
SECRET_KEY=change-me-to-a-random-string-in-production

# Database (SQLite default – change to PostgreSQL in production)
# DATABASE_URL=postgresql://user:password@localhost/redline

# Mail (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@redline.local
WORKSHOP_EMAIL=werkstatt@redline.local

# FileMaker Data API
FILEMAKER_HOST=https://your-filemaker-server.local
FILEMAKER_DATABASE=RedlineDB
FILEMAKER_USERNAME=admin
FILEMAKER_PASSWORD=your-filemaker-password

# The public URL where this app is accessible (used for QR code URLs)
APP_BASE_URL=http://your-server-address:5000

# Rate limiting storage (optional – defaults to in-memory, fine for single instance)
# Set to Redis URI for multi-instance / persistent rate limits:
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# Service ports (optional – defaults shown)
APP_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Grafana admin password (change before deploying!)
GRAFANA_ADMIN_PASSWORD=admin123
